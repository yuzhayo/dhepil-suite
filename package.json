{
  "name": "dhepil-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "electron"
  ],
  "scripts": {
    "workspace:clean": "node scripts/project-tsconfig-cleaner.ts",
    "predev": "npm run workspace:clean",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run workspace:clean",
    "build": "npm run typecheck && vite build",
    "desktop:dev": "node electron/scripts/desktop.mjs dev",
    "desktop:build": "node electron/scripts/desktop.mjs build",
    "desktop:build:all": "node electron/scripts/desktop.mjs build-all",
    "release:check": "node tooling/release/releaseApps.ts changed --dry-run",
    "release:changed": "node tooling/release/releaseApps.ts changed",
    "release:app": "node tooling/release/releaseApps.ts app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && npm run typecheck --workspace @dhepil-suite/desktop-runtime",
    "pretest": "npm run workspace:clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "antd": "6.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.1"
}
